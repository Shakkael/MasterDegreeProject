theme_override_font_sizes/normal_font_size = 32
text = "Dobrze Ci idzie. Poniżej masz całą wiedzę niezbędną do wykonania tego zadania:
- T.01 -> kliknij przycisk \"Poziom zaliczony\" by przejść dalej
- T.02 -> czasem trzeba wpisać hasło, by odblokować przycisk
- T.03 -> strona internetowa zawiera przydatne informacje
- T.04 -> możesz korzystać z plików gry
- T.05 -> na niektórych poziomach można przełączać taby klawiszem x"
